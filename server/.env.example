# ============================================================
#  UniPlatform — Variables d'environnement (serveur)
# ------------------------------------------------------------
#  Copiez ce fichier en "server/.env" puis renseignez vos
#  valeurs. Ne committez JAMAIS le vrai .env (il est ignoré
#  par .gitignore).
# ============================================================

# --- Application ---------------------------------------------
# Environnement : "development" en local, "production" en ligne
NODE_ENV=development
# Port du serveur Node (défaut : 3003)
PORT=3003
# URL publique de l'app (utilisée dans les liens des emails)
APP_URL=http://localhost:3003

# --- Base de données MySQL -----------------------------------
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=votre_mot_de_passe_mysql
DB_NAME=uniplatform

# --- Sécurité ------------------------------------------------
# Clé secrète pour signer les jetons JWT (mettez une longue
# chaîne aléatoire, ex: générée avec `openssl rand -hex 32`)
JWT_SECRET=remplacez_par_une_chaine_aleatoire_longue

# --- Visioconférence : LiveKit Cloud (SFU) -------------------
# Créez un projet gratuit sur https://cloud.livekit.io
# puis récupérez l'URL et les clés API du projet.
LIVEKIT_URL=wss://votre-projet.livekit.cloud
LIVEKIT_API_KEY=votre_livekit_api_key
LIVEKIT_API_SECRET=votre_livekit_api_secret

# --- Envoi d'emails : SMTP Gmail -----------------------------
# EMAIL_USER : votre adresse Gmail
# EMAIL_PASS : un "mot de passe d'application" Gmail (16 lettres)
#   -> activez la validation en 2 étapes, puis générez-le sur
#      https://myaccount.google.com/apppasswords
EMAIL_USER=votre.adresse@gmail.com
EMAIL_PASS=xxxx xxxx xxxx xxxx

# --- Stockage des fichiers -----------------------------------
# "false" : stockage local sur disque (dossier uploads)
# "true"  : stockage sur Google Drive (nécessite les variables
#           GOOGLE_* ci-dessous)
USE_GOOGLE_DRIVE=false
# Chemin du dossier d'uploads local (optionnel, défaut interne)
UPLOADS_PATH=

# --- Google Drive (uniquement si USE_GOOGLE_DRIVE=true) -------
# Identifiants OAuth2 d'un projet Google Cloud.
# Le refresh token s'obtient via le script server/getRefreshToken.js
GOOGLE_CLIENT_ID=votre_google_client_id
GOOGLE_CLIENT_SECRET=votre_google_client_secret
GOOGLE_REFRESH_TOKEN=votre_google_refresh_token
GOOGLE_DRIVE_FOLDER_ID=id_du_dossier_drive
