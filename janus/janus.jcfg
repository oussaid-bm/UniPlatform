general: {
  configs_folder = "/etc/janus"
  plugins_folder = "/usr/lib/janus/plugins"
  transports_folder = "/usr/lib/janus/transports"
  events_folder = "/usr/lib/janus/events"
  loggers_folder = "/usr/lib/janus/loggers"
  log_to_stdout = true
  debug_level = 4
  admin_secret = "janusoverlord"
  api_secret = "janusapisecret"
  token_auth = false
  session_timeout = 60
  reclaim_session_timeout = 0
}

certificates: {
}

media: {
  rtp_port_range = "20000-20100"
}

nat: {
  stun_server = "stun.l.google.com"
  stun_port = 19302
  nice_debug = false

  # Set these to your server's public IP for production
  # nat_1_1_mapping = "your.public.ip"
  # turn_server = "turn:global.relay.metered.ca:80"
  # turn_user = "ed5f9fd343f6092b3dcc81d7"
  # turn_pwd = "km71W6e3w0iXGk21"
  # turn_type = "udp"

  ice_lite = true
}
